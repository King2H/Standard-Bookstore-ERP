# ─── Node.js ───────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# ─── Build outputs ─────────────────────────────────────────
dist/
build/
out/
.next/
.nuxt/

# ─── Environment & secrets ─────────────────────────────────
.env
.env.*
!.env.example

# ─── OS files ──────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── Editor / IDE ──────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ─── Test coverage ─────────────────────────────────────────
coverage/
