{
  "name": "@bms/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "migrate": "dotenv -e ../../.env -- node-pg-migrate up --database-url-var DATABASE_URL --migrations-dir src/db/migrations",
    "migrate:down": "dotenv -e ../../.env -- node-pg-migrate down --database-url-var DATABASE_URL --migrations-dir src/db/migrations",
    "migrate:create": "dotenv -e ../../.env -- node-pg-migrate create --migrations-dir src/db/migrations",
    "db:types": "dotenv -e ../../.env -- kysely-codegen",
    "openapi": "tsx src/openapi/write.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "reseed": "node scripts/reseed.mjs",
    "reconcile": "node scripts/reconcile-inventory.mjs",
    "reconcile:dry": "node scripts/reconcile-inventory.mjs --dry-run",
    "reset-demo": "node scripts/reset-demo-data.mjs",
    "reset-demo:dry": "node scripts/reset-demo-data.mjs --dry-run",
    "reset-demo:force": "node scripts/reset-demo-data.mjs --force"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.4.5",
    "express": "^5.0.1",
    "helmet": "^8.3.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.2",
    "kysely": "^0.29.6",
    "pg": "^8.11.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.6",
    "@types/supertest": "^6.0.2",
    "dotenv-cli": "^7.4.2",
    "kysely-codegen": "^0.20.0",
    "node-pg-migrate": "^9.0.0",
    "supertest": "^7.0.0",
    "tsx": "^4.11.0",
    "typescript": "^5.4.5",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
