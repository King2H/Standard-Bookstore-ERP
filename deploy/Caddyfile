# The shop's web server (#31, owner decision 2a): HTTPS for the screens and
# the API on the shop's network, with the shop's own certificate authority,
# made at the first start and kept in the caddy_data volume. Counter PCs
# trust it once (deploy/trust-ca.ps1 or trust-ca.sh).
{
	local_certs
	skip_install_trust
	# The http:// site below sends everything to HTTPS itself, except the
	# certificate authority's certificate.
	auto_https disable_redirects
}

# BMS_SITE_ADDRESSES: how the counters reach this PC, e.g.
# "bookshop.local, 192.168.1.20, localhost" (set by the installer in .env).
{$BMS_SITE_ADDRESSES} {
	encode gzip

	handle /api/* {
		# Notifications stream over Server-Sent Events: flushed as they come.
		reverse_proxy api:3000 {
			flush_interval -1
		}
	}

	handle {
		root * /srv
		# Hashed assets never change; the page itself is always fetched fresh.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
	}
}

# Plain HTTP serves the certificate authority's public certificate, for a
# counter PC to trust before its first HTTPS visit, and sends the rest to HTTPS.
http:// {
	handle /ca.crt {
		root * /data/caddy/pki/authorities/local
		rewrite * /root.crt
		header Content-Type application/x-x509-ca-cert
		file_server
	}
	handle {
		redir https://{host}{uri} permanent
	}
}
