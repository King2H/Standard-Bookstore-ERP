# Database: PostgreSQL 18 from `docker compose up -d postgres` (host port 5433)
DATABASE_URL=postgres://bms:bms@localhost:5433/bms

# Auth
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change_this_to_a_secure_random_string_in_production

# Column-level encryption (AES-256-GCM) — required for bank account numbers and IBANs
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COLUMN_ENCRYPTION_KEY=replace_with_64_char_hex_string_generated_by_command_above

# App
# Anything other than development or test is treated as production: the API then
# refuses to start with the example secrets above.
NODE_ENV=development
PORT=3000

# Origins allowed to call the API from another site, comma-separated
# (e.g. https://shop.example.com). Leave empty when the web app is served from the
# same origin or through the dev proxy. In production, empty means no cross-origin access.
FRONTEND_URL=

# Number of reverse proxies in front of the API (usually 1), or their addresses.
# Leave empty when clients connect directly. Never "true".
TRUST_PROXY=

# Optional modules (off unless set to true)
FEATURE_BANK_ACCOUNTS=false
