# Database: PostgreSQL 18 from `docker compose up -d postgres` (host port 5433)
DATABASE_URL=postgres://bms:bms@localhost:5433/bms

# Auth
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change_this_to_a_secure_random_string_in_production

# Column-level encryption (AES-256-GCM) — required for bank account numbers and IBANs
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COLUMN_ENCRYPTION_KEY=replace_with_64_char_hex_string_generated_by_command_above

# App
NODE_ENV=development
PORT=3000
