{
  "name": "bookstore-management-system",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "apps/api",
    "apps/web",
    "packages/shared"
  ],
  "scripts": {
    "dev:api": "dotenv -e .env -- tsx watch apps/api/src/server.ts",
    "dev:web": "npm run dev --workspace=apps/web",
    "test": "npm run test --workspace=apps/api",
    "test:web": "npm run test --workspace=apps/web",
    "migrate": "npm run migrate --workspace=apps/api",
    "migrate:down": "npm run migrate:down --workspace=apps/api",
    "migrate:create": "npm run migrate:create --workspace=apps/api",
    "lint": "eslint apps/api/src apps/web/src packages/shared/src --ext .ts,.tsx",
    "format": "prettier --write \"apps/**/*.{ts,tsx}\" \"packages/**/*.ts\""
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "dotenv-cli": "^7.4.2",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.2.5",
    "tsx": "^4.11.0",
    "typescript": "^5.4.5"
  }
}
